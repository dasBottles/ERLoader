<mah:MetroWindow x:Class="ERLoader.Wpf.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 mc:Ignorable="d"
                 Title="ERLoader Prototype"
                 Height="920"
                 Width="1440"
                 MinHeight="760"
                 MinWidth="1200"
                 GlowBrush="#2DE2E6"
                 WindowStartupLocation="CenterScreen"
                 BorderBrush="#2B3954"
                 BorderThickness="1"
                 Style="{DynamicResource MahApps.Styles.MetroWindow.Clean}">
    <mah:MetroWindow.Resources>
        <Style x:Key="ProfileListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>
    <Grid Background="#0B1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="24,24,24,16"
                Padding="24"
                CornerRadius="18"
                Background="#111827"
                BorderBrush="#1F2A44"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="ERLoader"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Unified Elden Ring mod launcher prototype — Mod Engine 2 file mods, DLL mods, profiles, validation, and recovery in one shell."
                               Foreground="#9FB3C8"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                        <Border Margin="0,0,12,0" Padding="12,8" Background="#172033" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="Active profile" Foreground="#7DD3FC" FontSize="12" />
                                <TextBlock Text="{Binding ActiveProfileName}" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,12,0" Padding="12,8" Background="#172033" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="Readiness" Foreground="#A7F3D0" FontSize="12" />
                                <TextBlock Text="{Binding LaunchReadiness}" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12,8" Background="#172033" CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="Headline" Foreground="#FDE68A" FontSize="12" />
                                <TextBlock Text="{Binding HeadlineStatus}" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Margin="0,0,0,10"
                            Padding="18,10"
                            Click="LaunchPrototypeClicked"
                            FontWeight="SemiBold"
                            Background="#14B8A6"
                            Foreground="#04111D"
                            BorderThickness="0"
                            Content="Launch Active Profile" />
                    <Button Padding="18,10"
                            Click="SafeRecoveryClicked"
                            FontWeight="SemiBold"
                            Background="#24324A"
                            Foreground="White"
                            BorderBrush="#334155"
                            Content="Switch To Safe Recovery" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="18"
                    Background="#111827"
                    BorderBrush="#1F2A44"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock Text="Profiles"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Margin="0,6,0,18"
                               Text="Pick a profile, review launch state, and promote safe recovery as a first-class action."
                               Foreground="#9FB3C8"
                               TextWrapping="Wrap" />

                    <ListBox x:Name="ProfilesListBox"
                             Background="#0F172A"
                             BorderBrush="#25324A"
                             Foreground="White"
                             ItemsSource="{Binding Profiles}"
                             ItemContainerStyle="{StaticResource ProfileListBoxItemStyle}"
                             SelectedValuePath="Id"
                             Height="540"
                             SelectionChanged="ProfilesSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="14"
                                        CornerRadius="14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#172033" />
                                            <Setter Property="BorderBrush" Value="#22314B" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#13263D" />
                                                    <Setter Property="BorderBrush" Value="#2DE2E6" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" Foreground="White" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ReadyLabel}" Foreground="#7DD3FC" />
                                        </DockPanel>
                                        <TextBlock Margin="0,6,0,0" Text="{Binding Description}" TextWrapping="Wrap" Foreground="#9FB3C8" />
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <Border Padding="8,4" Background="#0F172A" CornerRadius="10" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Id}" Foreground="#CBD5E1" FontSize="12" />
                                            </Border>
                                            <Border Padding="8,4" Background="#0F172A" CornerRadius="10">
                                                <TextBlock Text="{Binding IsSafe, StringFormat=Safe profile: {0}}" Foreground="#CBD5E1" FontSize="12" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Margin="0,18,0,0"
                            Padding="14,10"
                            Click="ActivateSelectedProfileClicked"
                            Background="#24324A"
                            Foreground="White"
                            BorderBrush="#334155"
                            Content="Activate Selected Profile" />
                </StackPanel>
            </Border>

            <TabControl Grid.Column="2"
                        Background="#111827"
                        BorderBrush="#1F2A44"
                        BorderThickness="1"
                        Foreground="White"
                        Padding="12">
                <TabItem Header="Dashboard">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <UniformGrid Columns="3" Margin="0,0,0,20">
                                <Border Margin="0,0,12,0" Padding="18" Background="#172033" CornerRadius="16">
                                    <StackPanel>
                                        <TextBlock Text="Blockers" Foreground="#FCA5A5" FontSize="13" />
                                        <TextBlock Text="{Binding BlockerCount}" FontSize="34" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,12,0" Padding="18" Background="#172033" CornerRadius="16">
                                    <StackPanel>
                                        <TextBlock Text="Warnings" Foreground="#FDE68A" FontSize="13" />
                                        <TextBlock Text="{Binding WarningCount}" FontSize="34" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="18" Background="#172033" CornerRadius="16">
                                    <StackPanel>
                                        <TextBlock Text="Prototype mode" Foreground="#86EFAC" FontSize="13" />
                                        <TextBlock Text="No live game mutation" FontSize="22" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Padding="18" Background="#172033" CornerRadius="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="What this prototype proves" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,10,0,0" Foreground="#9FB3C8" TextWrapping="Wrap"
                                               Text="The shell already unifies profiles, file mods, DLL mods, validation, logs, and recovery in one desktop workflow. The next layers are importers and runtime wiring." />
                                </StackPanel>
                            </Border>

                            <Border Padding="18" Background="#172033" CornerRadius="16">
                                <StackPanel>
                                    <TextBlock Text="Active validation highlights" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ValidationItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Padding="12" Background="#0F172A" CornerRadius="12">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" Foreground="#7DD3FC" />
                                                        <TextBlock Margin="0,4,0,0" Text="{Binding Issue}" Foreground="White" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,4,0,0" Text="{Binding SuggestedFix}" Foreground="#9FB3C8" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="File Mods">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="File-based mod roots routed through Mod Engine 2" Foreground="#9FB3C8" Margin="0,0,0,12" />
                        <Border Grid.Row="1"
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="#13263D"
                                BorderBrush="#2DE2E6"
                                BorderThickness="1"
                                CornerRadius="14"
                                AllowDrop="True"
                                DragOver="FileModArchiveDragOver"
                                Drop="FileModArchiveDrop">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Import file-mod archive" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0" Text="Drag a .zip, .7z, or .rar into this panel, or browse to add a new file-mod archive to the prototype list." Foreground="#9FB3C8" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,10,0,0" Text="{Binding LastImportMessage}" Foreground="#7DD3FC" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="16,0,0,0"
                                        Padding="16,10"
                                        Click="BrowseFileModArchivesClicked"
                                        Background="#14B8A6"
                                        Foreground="#04111D"
                                        BorderThickness="0"
                                        Content="Browse Archives" />
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowBackground="#172033"
                                  AlternatingRowBackground="#142033"
                                  Background="#0F172A"
                                  Foreground="White"
                                  BorderBrush="#22314B"
                                  ItemsSource="{Binding FileMods}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="90" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="220" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Scope}" Width="120" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="DLL Mods">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="DLL compatibility layer preview with load order and delay management" Foreground="#9FB3C8" Margin="0,0,0,12" />
                        <Border Grid.Row="1"
                                Margin="0,0,0,12"
                                Padding="16"
                                Background="#13263D"
                                BorderBrush="#60A5FA"
                                BorderThickness="1"
                                CornerRadius="14"
                                AllowDrop="True"
                                DragOver="DllModArchiveDragOver"
                                Drop="DllModArchiveDrop">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Import DLL-mod archive" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0" Text="Drag a .zip, .7z, or .rar into this panel, or browse to add a new DLL-mod archive to the prototype queue." Foreground="#9FB3C8" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,10,0,0" Text="Archives are staged into the prototype queue with a default load delay and order." Foreground="#93C5FD" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="16,0,0,0"
                                        Padding="16,10"
                                        Click="BrowseDllModArchivesClicked"
                                        Background="#24324A"
                                        Foreground="White"
                                        BorderBrush="#334155"
                                        Content="Browse DLL Archives" />
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowBackground="#172033"
                                  AlternatingRowBackground="#142033"
                                  Background="#0F172A"
                                  Foreground="White"
                                  BorderBrush="#22314B"
                                  ItemsSource="{Binding DllMods}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="90" />
                                <DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}" Width="90" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="220" />
                                <DataGridTextColumn Header="Order" Binding="{Binding LoadOrder}" Width="80" />
                                <DataGridTextColumn Header="Delay (ms)" Binding="{Binding LoadDelayMs}" Width="100" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Validation">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Prototype validation shows how blockers and warnings surface before launch." Foreground="#9FB3C8" Margin="0,0,0,12" />
                        <Button Padding="14,10"
                                Width="180"
                                HorizontalAlignment="Left"
                                Click="RunValidationClicked"
                                Background="#24324A"
                                Foreground="White"
                                BorderBrush="#334155"
                                Content="Run Validation" />
                        <DataGrid Grid.Row="2"
                                  Margin="0,16,0,0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  RowBackground="#172033"
                                  AlternatingRowBackground="#142033"
                                  Background="#0F172A"
                                  Foreground="White"
                                  BorderBrush="#22314B"
                                  ItemsSource="{Binding ValidationItems}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="120" />
                                <DataGridTextColumn Header="Issue" Binding="{Binding Issue}" Width="*" />
                                <DataGridTextColumn Header="Suggested Fix" Binding="{Binding SuggestedFix}" Width="1.2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Logs">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="LogsListBox"
                                 Background="#0F172A"
                                 BorderBrush="#22314B"
                                 Foreground="White"
                                 ItemsSource="{Binding Logs}"
                                 SelectionChanged="LogsSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" Background="#172033" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Margin="0,4,0,0" Text="{Binding Category}" Foreground="#9FB3C8" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBox Grid.Column="2"
                                 Text="{Binding SelectedLogText}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 Background="#0F172A"
                                 Foreground="#D6E4F0"
                                 BorderBrush="#22314B"
                                 Padding="14"
                                 FontFamily="Consolas" />
                    </Grid>
                </TabItem>

                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock Text="Launcher settings preview" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,18" Text="This prototype keeps the advanced/regular-user split visible without wiring into the real runtime yet." Foreground="#9FB3C8" TextWrapping="Wrap" />

                            <Border Padding="18" Background="#172033" CornerRadius="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Game path" Foreground="#7DD3FC" FontSize="13" />
                                    <TextBox Margin="0,10,0,0" Text="C:\Steam\steamapps\common\ELDEN RING\Game\eldenring.exe" Background="#0F172A" Foreground="White" BorderBrush="#22314B" />
                                </StackPanel>
                            </Border>

                            <Border Padding="18" Background="#172033" CornerRadius="16" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox Content="Hide advanced settings by default" IsChecked="True" Foreground="White" />
                                    <CheckBox Margin="0,10,0,0" Content="Show log pane after launch" IsChecked="False" Foreground="White" />
                                    <CheckBox Margin="0,10,0,0" Content="Always keep safe/vanilla recovery visible" IsChecked="True" Foreground="White" />
                                </StackPanel>
                            </Border>

                            <Border Padding="18" Background="#172033" CornerRadius="16">
                                <StackPanel>
                                    <TextBlock Text="Prototype next steps" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,10,0,0" Foreground="#9FB3C8" TextWrapping="Wrap"
                                               Text="After UI approval, the next implementation steps are importer wiring, live config IO, launch blockers/warnings backed by real validation, and Mod Engine 2 runtime integration." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                Margin="24,0,24,24"
                Padding="16,12"
                Background="#111827"
                BorderBrush="#1F2A44"
                BorderThickness="1"
                CornerRadius="16">
            <DockPanel>
                <TextBlock Text="Prototype scope: mock data only, no live install mutation yet." Foreground="#9FB3C8" />
                <TextBlock DockPanel.Dock="Right" Text="Built for fast UX validation on Windows" Foreground="#7DD3FC" />
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
